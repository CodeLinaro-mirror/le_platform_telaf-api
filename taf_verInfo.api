//-------------------------------------------------------------------------------------------------
/**
 * @page c_tafVerInfo Version Information Service
 *
 * @rst :ref:`API reference <File taf_verInfo_interface.h>` @endrst
 *
 * @rst :ref:`Plugin APIs for hash <File tafPiHash.h>` @endrst
 *
 * @rst :ref:`Plugin APIs for version <File tafPiVersion.h>` @endrst
 *
 * <HR>
 *
 * The Version Information Service provides APIs to query software version strings and image
 * hashes for various components (kernel, firmware, TrustZone, TelAF, rootFS, LXC).
 *
 * @section taf_verInfo_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafVerInfoSvc application service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_verInfo-> tafVerInfoSvc.taf_verInfo
   }
   @endverbatim
 *
 * @section taf_verInfo_version_group Version query APIs
 *
 * These functions read the current version string of a software component into the caller-provided
 * buffer.
 *
 * @code
        char version[TAF_VERINFO_VERSION_MAX_BYTES] = { 0 };
        if (taf_verInfo_GetTelAFVersion(version, sizeof(version)) == LE_OK)
        {
            LE_INFO("TelAF version: %s", version);
        }
   @endcode
 *
 * - taf_verInfo_GetKernelVersion() -- Gets the kernel version string.
 * - taf_verInfo_GetFirmwareVersion() -- Gets the firmware version string.
 * - taf_verInfo_GetTZVersion() -- Gets the TrustZone version string.
 * - taf_verInfo_GetTelAFVersion() -- Gets the TelAF version string.
 * - taf_verInfo_GetRootFSVersion() -- Gets the root file system version string.
 * - taf_verInfo_GetLXCVersion() -- Gets the LXC version string (if supported on the target).
 *
 * @section taf_verInfo_hash_group Hash query APIs
 *
 * These functions return the hash bytes for a component image in the specified bank.
 *
 * - taf_verInfo_GetTelAFHash() -- Gets the TelAF image hash for the specified bank.
 * - taf_verInfo_GetBootHash() -- Gets the boot image hash for the specified bank.
 * - taf_verInfo_GetRootFSHash() -- Gets the rootFS image hash for the specified bank.
 * - taf_verInfo_GetFirmwareHash() -- Gets the firmware image hash for the specified bank.
 * - taf_verInfo_GetLXCHash() -- Gets the LXC image hash for the specified bank.
 *
 * @code
        uint8_t hash[TAF_VERINFO_HASH_MAX_BYTES] = { 0 };
        size_t hashSize = sizeof(hash);
        if (taf_verInfo_GetTelAFHash(TAF_VERINFO_BANK_A, hash, &hashSize) == LE_OK)
        {
            LE_INFO("TelAF hash size: %zu", hashSize);
        }
   @endcode
 *
 * <HR>
 *
 */
//------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;


//--------------------------------------------------------------------------------------------------
/**
 * Maximum version length including null termination character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE VERSION_MAX_BYTES = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum hash length including null termination character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE HASH_MAX_BYTES = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Bank enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Bank
{
    BANK_A,      ///< Bank A in dual system.
    BANK_B,      ///< Bank B in dual system.
    BANK_UNKNOWN ///< Unknown bank.
};

//--------------------------------------------------------------------------------------------------
/**
 * Gets the kernel version.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve version.
 *  - LE_BAD_PARAMETER -- Output buffer is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetKernelVersion
(
    string version[VERSION_MAX_BYTES] OUT    ///< Kernel version
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the firmware version.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve version.
 *  - LE_BAD_PARAMETER -- Output buffer is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirmwareVersion
(
    string version[VERSION_MAX_BYTES] OUT    ///< Firmware version
) = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the TZ version.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve version.
 *  - LE_BAD_PARAMETER -- Output buffer is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTZVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< TZ version
) = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the TelAF version.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve version.
 *  - LE_BAD_PARAMETER -- Output buffer is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTelAFVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< TelAF version
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the rootFS version.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve version.
 *  - LE_BAD_PARAMETER -- Output buffer is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRootFSVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< RootFS version
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the LXC version.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_UNSUPPORTED -- LXC version information is not available on the target.
 *  - LE_FAULT -- Failed to retrieve version.
 *  - LE_BAD_PARAMETER -- Output buffer is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLXCVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< LXC version
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Gets TelAF hash.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve hash.
 *  - LE_BAD_PARAMETER -- Bank is invalid, or output arguments are invalid.
 *  - LE_UNSUPPORTED -- Requested bank is not available.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTelAFHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< TelAF hash
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Gets boot hash.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve hash.
 *  - LE_BAD_PARAMETER -- Bank is invalid, or output arguments are invalid.
 *  - LE_UNSUPPORTED -- Hash plug-in is not loaded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBootHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< Boot hash
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the rootFS hash.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve hash.
 *  - LE_BAD_PARAMETER -- Bank is invalid, or output arguments are invalid.
 *  - LE_UNSUPPORTED -- Hash plug-in is not loaded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRootFSHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< Rootfs hash
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the firmware hash.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve hash.
 *  - LE_BAD_PARAMETER -- Bank is invalid, or output arguments are invalid.
 *  - LE_UNSUPPORTED -- Hash plug-in is not loaded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirmwareHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< Firmware hash
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the LXC hash.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed to retrieve hash.
 *  - LE_BAD_PARAMETER -- Bank is invalid, or output arguments are invalid.
 *  - LE_UNSUPPORTED -- LXC is not supported on the target, or requested bank is not available.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLXCHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< LXC hash
) = 10;