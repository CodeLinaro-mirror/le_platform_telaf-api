//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafUpdate Update Service
 *
 * @rst :ref:`API reference <File taf_update_interface.h>` @endrst
 *
 * @rst :ref:`Plugin APIs for download agent <File tafPiDA.h>` @endrst
 *
 * @rst :ref:`Plugin APIs for user agent <File tafPiUA.h>` @endrst
 *
 * <HR>
 *
 * The Update Service supports OTA firmware (FOTA) and application (SOTA) updates using QOTA
 * packages. Register a state handler to receive asynchronous update progress.
 *
 * @b NOTE: Firmware and application updates cannot run simultaneously.
 *
 * @section taf_update_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafUpdateSvc service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_update -> tafUpdateSvc.taf_update
   }
   @endverbatim
 *
 * @section c_taf_update_ota_function OTA functions
 *
 * - taf_update_Download() / taf_update_GetDownloadSession() / taf_update_StartDownload() /
 *   taf_update_PauseDownload() / taf_update_ResumeDownload() / taf_update_CancelDownload() --
 *   Download APIs: Download() starts the legacy download flow; the others acquire and manage a
 *   session-based download.
 * - taf_update_GetInstallationSession() / taf_update_Install() / taf_update_StartInstall() /
 *   taf_update_PauseInstall() / taf_update_ResumeInstall() / taf_update_CancelInstall() --
 *   Installation APIs: GetInstallationSession() obtains a session for the given package type;
 *   Install() queues the install using the legacy flow; the others control a session-based install.
 * - taf_update_InstallPreCheck() / taf_update_InstallPostCheck() -- Optional pre/post-install
 *   checks. These APIs are optional and may be skipped if not required.
 * - taf_update_EraseBank() -- Erases the inactive bank before flashing to ensure a clean target
 *   bank. Call this separately before starting installation if needed.
 * - taf_update_GetActiveBank() / taf_update_VerifyActivation() / taf_update_PauseActivation() /
 *   taf_update_ResumeActivation() -- Query the active bank and control the activation workflow.
 * - taf_update_Sync() / taf_update_StartSync() / taf_update_PauseSync() /
 *   taf_update_ResumeSync() / taf_update_CancelSync() -- Manages A/B bank synchronization.
 * - taf_update_Rollback() -- Starts rollback.
 * - taf_update_AddStateHandler() / taf_update_RemoveStateHandler() -- Registers/Unregisters update
 *   state handler.
 *
 * @code
   void UpdateStateHandler(taf_update_StateInd_t* indication, void* contextPtr)
   {
       switch (indication->state) {
           case TAF_UPDATE_IDLE:
               taf_update_Download();
               break;
           case TAF_UPDATE_DOWNLOADING:
               LE_INFO("Downloading %d%%.", indication->percent);
               break;
           case TAF_UPDATE_DOWNLOAD_FAIL:
               LE_ERROR("Download failed.");
               break;
           case TAF_UPDATE_DOWNLOAD_SUCCESS:
               if (indication->ota == TAF_UPDATE_PACKAGE_FOTA) {
                   taf_update_Install(TAF_UPDATE_FOTA, indication->name);
               } else {
                   taf_update_Install(TAF_UPDATE_SOTA, indication->name);
               }
               break;
           case TAF_UPDATE_INSTALLING:
               LE_INFO("Installing %d%%.", indication->percent);
               break;
           case TAF_UPDATE_INSTALL_SUCCESS:
               // Reboot to activate firmware, or start app probation.
               break;
        }
   }

   handlerRef = taf_update_AddStateHandler((taf_update_StateHandlerFunc_t)UpdateStateHandler, NULL);
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;


//--------------------------------------------------------------------------------------------------
/**
 * Maximum OTA package name length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_PKG_NAME_LEN = 48;

//--------------------------------------------------------------------------------------------------
/**
 * File path length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE FILE_PATH_LEN = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Session name length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SESSION_NAME_LEN = 32;

//--------------------------------------------------------------------------------------------------
/**
 * Update session reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Session;

//--------------------------------------------------------------------------------------------------
/**
 * Update states.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    IDLE,              ///< Idle; ready to download.
    DOWNLOADING,       ///< Download in progress.
    DOWNLOAD_PAUSED,   ///< Download paused.
    DOWNLOAD_SUCCESS,  ///< Download completed successfully.
    DOWNLOAD_FAIL,     ///< Download failed.
    INSTALLING,        ///< Installation in progress.
    INSTALL_PAUSED,    ///< Installation paused.
    INSTALL_SUCCESS,   ///< Installation completed; reboot or start probation.
    INSTALL_FAIL,      ///< Installation failed.
    PROBATION,         ///< Probation in progress.
    PROBATION_PAUSED,  ///< Probation paused.
    PROBATION_SUCCESS, ///< Probation passed.
    PROBATION_FAIL,    ///< Probation failed.
    ROLLBACK,          ///< Rollback in progress.
    ROLLBACK_SUCCESS,  ///< Rollback succeeded.
    ROLLBACK_FAIL,     ///< Rollback failed.
    SYNCHRONIZING,     ///< Bank synchronization in progress.
    SYNC_SUCCESS,      ///< Bank synchronization succeeded.
    SYNC_PAUSED,       ///< Bank synchronization paused.
    SYNC_FAIL,         ///< Bank synchronization failed.
    REPORTING          ///< Reporting state to server.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error codes.
 */
//--------------------------------------------------------------------------------------------------
ENUM Error
{
    NONE,              ///< No errors.
    BAD_PACKAGE,       ///< Bad package.
    INTERNAL_ERROR,    ///< Internal error.
    SECURITY_FAILURE,  ///< Security check failure.
    PACKAGE_NOT_FOUND, ///< Package not found.
    APP_NOT_RUNNING,   ///< App is not running.
    INVALID_OPERATION, ///< Invalid operation.
    IMAGE_NOT_VERFIED, ///< Image not verified.
    IO_ERROR,          ///< I/O error.
    NO_MEM_ERROR,      ///< Out of memory.
    INVAL_ARG_ERROR,   ///< Invalid argument.
    BUSY_ERROR,        ///< Device or resource busy.
    NODEV_ERROR        ///< No such device or resource.
};

//--------------------------------------------------------------------------------------------------
/**
 * OTA workflows.
 */
//--------------------------------------------------------------------------------------------------
ENUM OTA
{
    FOTA,    ///< Firmware update.
    SOTA,    ///< Application update.
    NON_QOTA ///< Not a QOTA workflow.
};

//--------------------------------------------------------------------------------------------------
/**
 * Update package type.
 */
//--------------------------------------------------------------------------------------------------
ENUM PackageType
{
    PACKAGE_TYPE_QOTA_PACKAGE, ///< Package with QOTA header.
    PACKAGE_TYPE_NAD_ZIP,      ///< Zip file for NAD update.
    PACKAGE_TYPE_TELAF_APP,    ///< TelAF app bundle.
    PACKAGE_TYPE_UAPI_PACKAGE, ///< Package for UA plug-in update.
    PACKAGE_TYPE_UNKNOWN       ///< Unknown package.
};

//--------------------------------------------------------------------------------------------------
/**
 * Bank enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Bank
{
    BANK_A,      ///< Bank A.
    BANK_B,      ///< Bank B.
    BANK_UNKNOWN ///< Unknown bank.
};

//--------------------------------------------------------------------------------------------------
/**
 * Update state indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT StateInd
{
    State state;                   ///< Update state.
    Error error;                   ///< Error code.
    uint32 percent;                ///< Progress percentage.
    OTA ota;                       ///< OTA workflow.
    string name[SESSION_NAME_LEN]; ///< Session name.
};

//--------------------------------------------------------------------------------------------------
/**
 * Handler for update state changes.
 *
 * @param[in] stateInd   Update state indication.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER StateHandler
(
    StateInd stateInd IN ///< Update state indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report update progress.
 */
//--------------------------------------------------------------------------------------------------
EVENT State
(
    StateHandler handler ///< Handler for update state.
) = (0,1);

//--------------------------------------------------------------------------------------------------
/**
 * Downloads an OTA package from a cloud server.
 *
 * @b NOTE: The QOTA header is removed after download completes.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Download
(
) = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Installs an OTA package on the target device.
 *
 * @b NOTE: QOTA header must be removed before calling this API.
 *
 * @return
 * - LE_OK -- Install request queued successfully.
 * - LE_BAD_PARAMETER -- Invalid pkgPath for application install.
 * - LE_FAULT -- Installation session not found.
 * - LE_UNSUPPORTED -- OTA/session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Install
(
    OTA ota IN,                      ///< OTA workflow.
    string name[MAX_PKG_NAME_LEN] IN ///< OTA package name.
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Gets a download session.
 *
 * @return
 * - LE_OK -- Download session reference returned successfully.
 * - LE_BAD_PARAMETER -- session is null.
 * - LE_FAULT -- Lower-layer failure.
 * - LE_UNSUPPORTED -- Download agent unavailable or session creation not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDownloadSession
(
    string cfgFile[FILE_PATH_LEN] IN, ///< Configuration file for download session.
    Session session OUT               ///< Download session reference.
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Starts download.
 *
 * @return
 * - LE_OK -- Request queued successfully.
 * - LE_FAULT -- Invalid session or wrong workflow state.
 * - LE_UNSUPPORTED -- Operation not supported for this session type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartDownload
(
    Session session IN ///< Download session reference.
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Pauses download.
 *
 * @return
 * - LE_OK -- Request queued successfully.
 * - LE_FAULT -- Invalid session or wrong workflow state.
 * - LE_UNSUPPORTED -- Operation not supported for this session type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t PauseDownload
(
    Session session IN ///< Download session reference.
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Resumes download.
 *
 * @return
 * - LE_OK -- Request queued successfully.
 * - LE_FAULT -- Invalid session or wrong workflow state.
 * - LE_UNSUPPORTED -- Operation not supported for this session type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResumeDownload
(
    Session session IN ///< Download session reference.
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Cancels download.
 *
 * @return
 * - LE_OK -- Request queued successfully.
 * - LE_FAULT -- Invalid session or wrong workflow state.
 * - LE_UNSUPPORTED -- Operation not supported for this session type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CancelDownload
(
    Session session IN ///< Download session reference.
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Gets an installation session.
 *
 * @return
 * - LE_OK -- Installation session reference returned successfully.
 * - LE_BAD_PARAMETER -- session is null.
 * - LE_FAULT -- Lower-layer failure.
 * - LE_UNSUPPORTED -- Package type not supported or update agent unavailable.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInstallationSession
(
    PackageType pkgType IN,           ///< Package type.
    string cfgFile[FILE_PATH_LEN] IN, ///< Configuration file for installation session.
    Session session OUT               ///< Installation session reference.
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Checks prerequisites for installation.
 *
 * @return
 * - LE_OK -- Pre-check passed or skipped (no manifest).
 * - LE_FAULT -- Invalid session or pre-check failed.
 * - LE_UNSUPPORTED -- Pre-check not supported for this session type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t InstallPreCheck
(
    Session session IN,               ///< Installation session reference.
    string manifest[FILE_PATH_LEN] IN ///< Manifest for pre-check.
) = 10;

//--------------------------------------------------------------------------------------------------
/**
 * Starts installation.
 *
 * @return
 * - LE_OK -- Install request queued successfully.
 * - LE_BAD_PARAMETER -- Invalid pkgPath for application install.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartInstall
(
    Session session IN,              ///< Installation session reference.
    string pkgPath[FILE_PATH_LEN] IN ///< Package path.
) = 11;

//--------------------------------------------------------------------------------------------------
/**
 * Pauses installation.
 *
 * @return
 * - LE_OK -- Request accepted successfully.
 * - LE_FAULT -- Invalid session or wrong workflow state.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t PauseInstall
(
    Session session IN ///< Installation session reference.
) = 12;

//--------------------------------------------------------------------------------------------------
/**
 * Resumes installation.
 *
 * @return
 * - LE_OK -- Request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResumeInstall
(
    Session session IN ///< Installation session reference.
) = 13;

//--------------------------------------------------------------------------------------------------
/**
 * Cancels installation.
 *
 * @return
 * - LE_OK -- Cancel request accepted successfully.
 * - LE_FAULT -- Invalid session or wrong workflow state.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CancelInstall
(
    Session session IN ///< Installation session reference.
) = 14;

//--------------------------------------------------------------------------------------------------
/**
 * Verifies that the inactive bank was flashed correctly after installation.
 *
 * @return
 * - LE_OK -- Post-check request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t InstallPostCheck
(
    Session session IN ///< Installation session reference.
) = 15;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the active bank.
 *
 * @return
 * - LE_OK -- Active bank returned successfully.
 * - LE_BAD_PARAMETER -- bank is null.
 * - LE_FAULT -- Invalid session or failed to get active bank.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetActiveBank
(
    Session session IN, ///< Installation session reference.
    Bank bank OUT       ///< The active bank.
) = 16;

//--------------------------------------------------------------------------------------------------
/**
 * Erases a bank.
 *
 * @b NOTE: The SBL partition will not be erased.
 *
 * @return
 * - LE_OK -- Bank erased successfully.
 * - LE_FAULT -- Invalid session or erase failed.
 * - LE_UNSUPPORTED -- Session type not supported, or bank is the active bank.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t EraseBank
(
    Session session IN, ///< Installation session reference.
    Bank bank IN        ///< The bank to erase.
) = 17;

//--------------------------------------------------------------------------------------------------
/**
 * Verifies that each component has the updated version after activation.
 *
 * @return
 * - LE_OK -- Verification request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t VerifyActivation
(
    Session session IN,               ///< Installation session reference.
    string manifest[FILE_PATH_LEN] IN ///< Manifest for activation verification.
) = 18;

//--------------------------------------------------------------------------------------------------
/**
 * Pauses activation.
 *
 * @return
 * - LE_OK -- Pause request accepted successfully.
 * - LE_FAULT -- Invalid session or wrong activation state.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t PauseActivation
(
    Session session IN ///< Installation session reference.
) = 19;

//--------------------------------------------------------------------------------------------------
/**
 * Resumes activation.
 *
 * @return
 * - LE_OK -- Resume request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResumeActivation
(
    Session session IN ///< Installation session reference.
) = 20;

//--------------------------------------------------------------------------------------------------
/**
 * Rolls back to the previous configuration.
 *
 * @return
 * - LE_OK -- Rollback request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Rollback
(
    Session session IN ///< Installation session reference.
) = 21;

//--------------------------------------------------------------------------------------------------
/**
 * Starts A/B bank synchronization.
 *
 * @return
 * - LE_OK -- Sync request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Sync
(
    Session session IN ///< Installation session reference.
) = 22;

//--------------------------------------------------------------------------------------------------
/**
 * Starts A/B sync.
 *
 * @return
 * - LE_OK -- Request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSync
(
    Session session IN ///< Sync session reference.
) = 23;

//--------------------------------------------------------------------------------------------------
/**
 * Pauses A/B sync.
 *
 * @return
 * - LE_OK -- Pause request accepted successfully.
 * - LE_FAULT -- Invalid session or wrong sync state.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t PauseSync
(
    Session session IN ///< Sync session reference.
) = 24;

//--------------------------------------------------------------------------------------------------
/**
 * Resumes A/B sync.
 *
 * @return
 * - LE_OK -- Resume request queued successfully.
 * - LE_FAULT -- Invalid session.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResumeSync
(
    Session session IN ///< Sync session reference.
) = 25;

//--------------------------------------------------------------------------------------------------
/**
 * Cancels A/B sync.
 *
 * @return
 * - LE_OK -- Cancel request accepted successfully.
 * - LE_FAULT -- Invalid session or wrong sync state.
 * - LE_UNSUPPORTED -- Session type not supported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CancelSync
(
    Session session IN ///< Sync session reference.
) = 26;