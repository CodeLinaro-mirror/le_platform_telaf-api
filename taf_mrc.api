//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafMRC MRC Service
 *
 * @rst :ref:`API reference <File taf_mrc_interface.h>` @endrst
 *
 * <HR>
 *
 * The MRC (Memory Robustness Criteria) service provides APIs to communicate with the MRC daemon
 * (MRCD). MRCD runs in the background to support EFS2 backup/restore, system mirroring, flash
 * scrubbing, eCall suspend, and flash access arbitration.
 *
 * @section taf_mrc_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafMRCSvc service.
 *
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_mrc -> tafMRCSvc.taf_mrc
   }
 *
   @endverbatim
 *
 * @section c_taf_mrc_ota OTA operations
 *
 * Use these APIs to notify MRCD about OTA lifecycle events and A/B synchronization.
 *
 * - taf_mrc_SendOtaStartMsg() -- Notifies MRCD that OTA is starting.
 * - taf_mrc_SendOtaResumeMsg() -- Notifies MRCD that a paused OTA is resuming.
 * - taf_mrc_SendOtaEndMsg() -- Notifies MRCD that OTA has finished.
 * - taf_mrc_SendOtaAbsyncMsg() -- Requests MRCD to perform A/B synchronization.
 * - taf_mrc_SendSyncStatusMsg() -- Reports A/B synchronization progress to MRCD.
 *
 * @code
 *
   le_result_t res;

   // When OTA is about to start.
   res = taf_mrc_SendOtaStartMsg();
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SendOtaStartMsg failed: %d", res);
       return;
   }

   // Perform OTA with recovery client or flash access.

   // When OTA is ended.
   res = taf_mrc_SendOtaEndMsg(TAF_MRC_OTA_OP_STATUS_SUCCESS);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SendOtaEndMsg failed: %d", res);
       return;
   }

   // A/B synchronization.
   res = taf_mrc_SendOtaAbsyncMsg();
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SendOtaAbsyncMsg failed: %d", res);
       return;
   }

   // Notify synchronization state changes.
   res = taf_mrc_SendSyncStatusMsg(TAF_MRC_SYNC_STATUS_INIT);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SendSyncStatusMsg(init) failed: %d", res);
       return;
   }

   res = taf_mrc_SendSyncStatusMsg(TAF_MRC_SYNC_STATUS_SUCCESS);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SendSyncStatusMsg(success) failed: %d", res);
       return;
   }

 *
   @endcode
 *
 * @section c_taf_mrc_efs EFS metrics operations
 *
 * Use these APIs to measure EFS flash health metrics. Call taf_mrc_MeasureEfsMetrics() to get a
 * metrics reference, use the getter APIs to read individual values, then call
 * taf_mrc_DeleteEfsMetrics() to release the reference.
 *
 * - taf_mrc_MeasureEfsMetrics() -- Collects EFS metrics and return a reference.
 * - taf_mrc_DeleteEfsMetrics() -- Releases a metrics reference.
 * - taf_mrc_GetEfsMaxPECount() -- Gets the maximum Program/Erase count.
 * - taf_mrc_GetEfsMinPECount() -- Gets the minimum Program/Erase count.
 * - taf_mrc_GetEfsAvgPECount() -- Gets the average Program/Erase count.
 * - taf_mrc_GetEfsPEStandardDeviation() -- Gets the standard deviation of Program/Erase counts.
 * - taf_mrc_GetEfsBadBlocks() -- Gets the bad block count.
 * - taf_mrc_GetEfsBlocksInPECountRange() -- Gets the number of blocks in a P/E count range.
 * - taf_mrc_SetEfsBackupPeriod() -- Sets the EFS backup timer period (in seconds).
 *
 * @code
 *
   taf_mrc_MetricsRef_t metricsRef = NULL;
   uint32_t count = 0;
   uint32_t sd = 0;
   le_result_t res;

   // Measure EFS metrics.
   res = taf_mrc_MeasureEfsMetrics(&metricsRef);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_MeasureEfsMetrics failed: %d", res);
       return;
   }

   // Get the maximum program and erase count in EFS.
   res = taf_mrc_GetEfsMaxPECount(metricsRef, &count);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_GetEfsMaxPECount failed: %d", res);
       goto cleanup;
   }
   LE_INFO("Max PE count: %u", count);

   // Get the minimum program and erase count in EFS.
   res = taf_mrc_GetEfsMinPECount(metricsRef, &count);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_GetEfsMinPECount failed: %d", res);
       goto cleanup;
   }
   LE_INFO("Min PE count: %u", count);

   // Get the average program and erase count in EFS.
   res = taf_mrc_GetEfsAvgPECount(metricsRef, &count);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_GetEfsAvgPECount failed: %d", res);
       goto cleanup;
   }
   LE_INFO("Avg PE count: %u", count);

   // Get the standard deviation of program and erase count in EFS.
   res = taf_mrc_GetEfsPEStandardDeviation(metricsRef, &sd);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_GetEfsPEStandardDeviation failed: %d", res);
       goto cleanup;
   }
   LE_INFO("Standard deviation: %u", sd);

   // Get the bad block count in EFS.
   res = taf_mrc_GetEfsBadBlocks(metricsRef, &count);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_GetEfsBadBlocks failed: %d", res);
       goto cleanup;
   }
   LE_INFO("Bad block count: %u", count);

   // Get the number of blocks whose P/E count is within 20K-40K.
   res = taf_mrc_GetEfsBlocksInPECountRange(metricsRef, 20000, 40000, &count);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_GetEfsBlocksInPECountRange failed: %d", res);
       goto cleanup;
   }
   LE_INFO("Blocks in [20K, 40K): %u", count);

   // Set the period of EFS backup.
   res = taf_mrc_SetEfsBackupPeriod(3600);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SetEfsBackupPeriod failed: %d", res);
   }

cleanup:
   if (metricsRef != NULL)
   {
       res = taf_mrc_DeleteEfsMetrics(metricsRef);
       if (res != LE_OK)
       {
           LE_ERROR("taf_mrc_DeleteEfsMetrics failed: %d", res);
       }
   }
 *
   @endcode
 *
 * @section c_taf_mrc_toggle Toggle notification operations
 *
 * MRCD can request a bank toggle asynchronously. The clients subscribe to the ToggleBank
 * operation request event, handle the request in the callback, then acknowledge the result
 * with taf_mrc_SetGpioToggleStatus().
 *
 * - taf_mrc_AddToggleBankHandler() -- Subscribes to bank toggle request or status from MRCD.
 * - taf_mrc_SetGpioToggleStatus() -- Acknowledges the GPIO toggle result to MRCD.
 *
 * @code
 *
   static void MyToggleBankHandler
   (
       taf_mrc_ToggleStatus_t status,
       taf_mrc_Bank_t bank,
       taf_mrc_Error_t error,
       void* contextPtr
   )
   {
       le_result_t res;

       LE_UNUSED(bank);
       LE_UNUSED(error);
       LE_UNUSED(contextPtr);

       if (status != TAF_MRC_TOGGLE_STATUS_REQUESTED)
       {
           return;
       }

       // Perform board-specific bank toggle handling here.

       res = taf_mrc_SetGpioToggleStatus(TAF_MRC_TOGGLE_STATUS_SUCCEEDED);
       if (res != LE_OK)
       {
           LE_ERROR("taf_mrc_SetGpioToggleStatus failed: %d", res);
       }
   }

   static taf_mrc_ToggleBankHandlerRef_t handlerRef = NULL;
   le_result_t res;

   handlerRef = taf_mrc_AddToggleBankHandler(MyToggleBankHandler, NULL);
   if (handlerRef == NULL)
   {
       LE_ERROR("taf_mrc_AddToggleBankHandler failed");
       return;
   }

   // Later, when a toggle request is no longer expected, acknowledge failures explicitly.
   res = taf_mrc_SetGpioToggleStatus(TAF_MRC_TOGGLE_STATUS_FAILED);
   if (res != LE_OK)
   {
       LE_ERROR("taf_mrc_SetGpioToggleStatus(failed) returned %d", res);
   }

 *
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;

//--------------------------------------------------------------------------------------------------
/**
 * OTA status enum.
 *
 * @b NOTE: OTA status notified to MRCD.
 */
//--------------------------------------------------------------------------------------------------
ENUM OtaOperationStatus
{
    OTA_OP_STATUS_SUCCESS = 1, ///< OTA status is success.
    OTA_OP_STATUS_FAILURE      ///< OTA status is failure.
};

//--------------------------------------------------------------------------------------------------
/**
 * Synchronization status enum.
 *
 * @b NOTE: Sync status notified to MRCD.
 */
//--------------------------------------------------------------------------------------------------
ENUM SyncStatus
{
    SYNC_STATUS_INIT = 0,    ///< Synchronization is initialized by client.
    SYNC_STATUS_SUCCESS,     ///< Synchronization status is success.
    SYNC_STATUS_FAILURE      ///< Synchronization status is failure.
};

//--------------------------------------------------------------------------------------------------
/**
 * Toggle status enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM ToggleStatus
{
    TOGGLE_STATUS_UNKNOWN = -1, ///< Toggle status unknown.
    TOGGLE_STATUS_REQUESTED,    ///< Request to perform toggle.
    TOGGLE_STATUS_SUCCEEDED,    ///< Toggle succeeded.
    TOGGLE_STATUS_FAILED        ///< Toggle failed.
};

//--------------------------------------------------------------------------------------------------
/**
 * Bank enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Bank
{
    BANK_UNKNOWN = -1, ///< Unknown bank.
    BANK_A,            ///< Bank A.
    BANK_B             ///< Bank B.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Error
{
    ERROR_UNKNOWN = -1, ///< Unknown error.
    ERROR_NONE          ///< No errors.
};

//--------------------------------------------------------------------------------------------------
/**
 * The metrics reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Metrics;

//--------------------------------------------------------------------------------------------------
/**
 * Sends a message to the MRCD to indicate that OTA is about to start.
 *
 * @return
 *  - LE_OK -- Request accepted.
 *  - LE_FAULT -- Request failed.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaStartMsg
(
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Sends a message to the MRCD to indicate that OTA is about to resume.
 *
 * @return
 *  - LE_OK -- Request accepted.
 *  - LE_FAULT -- Request failed.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaResumeMsg
(
) = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Sends a message to the MRCD to indicate that OTA is ended.
 *
 * @return
 *  - LE_OK -- Request accepted.
 *  - LE_FAULT -- Request failed.
 *  - LE_BAD_PARAMETER -- Invalid otaStatus value.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaEndMsg
(
    OtaOperationStatus otaStatus IN ///< OTA status.
) = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Sends a message to the MRCD to perform AB synchronization.
 *
 * @return
 *  - LE_OK -- Request accepted.
 *  - LE_FAULT -- Request failed.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaAbsyncMsg
(
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Sends a message to the MRCD to indicate that AB synchronization is about to start or AB
 * synchronization is ended.
 *
 * @return
 *  - LE_OK -- Request accepted.
 *  - LE_FAULT -- Request failed.
 *  - LE_BAD_PARAMETER -- Invalid status value.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendSyncStatusMsg
(
    SyncStatus status IN ///< AB synchronization status.
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Measures the EFS metrics.
 *
 * @return
 *  - LE_OK -- Metrics collected successfully.
 *  - LE_FAULT -- Failed to collect metrics.
 *  - LE_BAD_PARAMETER -- MetricsRef is null or invalid parameter.
 *  - LE_TIMEOUT -- Operation timed out.
 *  - LE_UNSUPPORTED -- Not supported.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MeasureEfsMetrics
(
    Metrics MetricsRef OUT ///< The EFS metrics reference.
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the EFS metrics.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteEfsMetrics
(
    Metrics MetricsRef IN ///< The EFS metrics reference.
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the maximum Program/Erase(PE) count in EFS.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEfsMaxPECount
(
    Metrics MetricsRef IN, ///< The EFS metrics reference.
    uint32 count OUT       ///< The maximum Program/Erase(PE) count in EFS.
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the minimum Program/Erase(PE) count in EFS.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEfsMinPECount
(
    Metrics MetricsRef IN, ///< The EFS metrics reference.
    uint32 count OUT       ///< The minimum Program/Erase(PE) count in EFS.
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the average program and erase count in EFS.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEfsAvgPECount
(
    Metrics MetricsRef IN, ///< The EFS metrics reference.
    uint32 count OUT       ///< The average Program/Erase(PE) count in EFS.
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the standard deviation of Program/Erase(PE) count in EFS.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEfsPEStandardDeviation
(
    Metrics MetricsRef IN, ///< The EFS metrics reference.
    uint32 value OUT       ///< The standard deviation which rounds up to the closest integer.
) = 10;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the bad block count in EFS.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEfsBadBlocks
(
    Metrics MetricsRef IN, ///< The EFS metrics reference.
    uint32 count OUT       ///< The bad block count in EFS.
) = 11;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the period of EFS backup.
 *
 * @return
 *  - LE_OK -- Period set successfully.
 *  - LE_FAULT -- Request failed.
 *  - LE_BAD_PARAMETER -- Invalid parameter.
 *  - LE_TIMEOUT -- Operation timed out.
 *  - LE_UNSUPPORTED -- Not supported.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetEfsBackupPeriod
(
    uint32 period IN       ///< Period in second.
) = 12;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the GPIO toggle status.
 *
 * @instaging
 *
 * @return
 *  - LE_OK -- Status acknowledged successfully.
 *  - LE_FAULT -- Request failed.
 *  - LE_BAD_PARAMETER -- Invalid status value.
 *  - LE_TIMEOUT -- Operation timed out.
 *  - LE_UNSUPPORTED -- Not supported.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetGpioToggleStatus
(
    ToggleStatus status IN ///< The GPIO toggle status.
) = 13;

//--------------------------------------------------------------------------------------------------
/**
 * Handler for toggling bank.
 *
 * @instaging
 *
 * @param[in] status     Toggle status.
 * @param[in] bank       The target bank for the toggle request.
 * @param[in] error      Error code associated with the toggle request.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER ToggleBankHandler
(
    ToggleStatus status IN, ///< Toggle status.
    Bank bank IN,           ///< The target bank for toggling.
    Error error IN          ///< Error code for toggling bank.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report toggle bank.
 */
//--------------------------------------------------------------------------------------------------
EVENT ToggleBank
(
    ToggleBankHandler handler ///< Handler for toggling bank.
) = (14,15);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the number of blocks whose Program/Erase(PE) count falls within the range [lower, upper).
 *
 * The range is half-open: lower <= PE count < upper. To count the highest open-ended band, pass
 * upper = UINT32_MAX.
 *
 * Example: for bands <20K, 20K-40K, 40K-60K, >=60K, call with [0, 20000), [20000, 40000),
 * [40000, 60000), and [60000, UINT32_MAX) respectively.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters (lower >= upper, or null count).
 *  - LE_NOT_FOUND -- Reference not found.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEfsBlocksInPECountRange
(
    Metrics MetricsRef IN, ///< The EFS metrics reference.
    uint32 lower IN,       ///< Lower bound (inclusive).
    uint32 upper IN,       ///< Upper bound (exclusive).
    uint32 count OUT       ///< Number of blocks with lower <= PE count < upper.
) = 16;
