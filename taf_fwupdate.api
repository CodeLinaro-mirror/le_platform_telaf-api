//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafFwUpdate Firmware Update Service
 *
 * @rst :ref:`API reference <File taf_fwupdate_interface.h>` @endrst
 *
 * <HR>
 *
 * The Firmware Update service provides APIs for OTA firmware updates.
 *
 * @section taf_fwupdate_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafUpdateSvc service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_fwupdate -> tafUpdateSvc.taf_fwupdate
   }
   @endverbatim
 *
 * @section c_taf_update_fota_function FOTA functions
 *
 * - taf_fwupdate_RebootToActive() -- Reboot to the active slot after activation.
 * - taf_fwupdate_GetFirmwareVersion() -- Get the current firmware version string.
 * - taf_fwupdate_Install() -- Start local firmware installation.
 *
 * @code
   char version[TAF_FWUPDATE_MAX_VERS_LEN] = {0};
   le_result_t res = taf_fwupdate_GetFirmwareVersion(version);
   if (res != LE_OK)
   {
       LE_ERROR("Failed to get firmware version: %d", res);
       return;
   }
   LE_INFO("Firmware version: %s", version);

   res = taf_fwupdate_Install();
   if (res != LE_OK)
   {
       LE_ERROR("Failed to start firmware install: %d", res);
       return;
   }
   // Wait for update state indications from taf_update.
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum firmware version string length including null terminator.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_VERS_LEN = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Reboots the device to the active slot.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION RebootToActive
(
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the current firmware version string.
 *
 * @return
 *  - LE_OK -- Success.
 *  - LE_BAD_PARAMETER -- version is null.
 *  - LE_FAULT -- Failed to obtain or parse the firmware version.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirmwareVersion
(
    string version[MAX_VERS_LEN] OUT ///< Firmware version string.
) = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Starts local firmware installation.
 *
 * @b NOTE: For local firmware update only. Final result is reported asynchronously via update
 *          state indications.
 *
 * @return
 *  - LE_OK -- Install request queued successfully.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Install
(
) = 2;