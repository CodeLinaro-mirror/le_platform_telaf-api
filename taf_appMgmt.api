//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafAppMgmt Application Management Service
 *
 * @rst :ref:`API reference <File taf_appMgmt_interface.h>` @endrst
 *
 * <HR>
 *
 * The Application Management service provides APIs to control and query user applications.
 *
 * @note This service does not support read-only (RO) systems.
 *
 * @section taf_appMgmt_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafUpdateSvc service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_appMgmt -> tafUpdateSvc.taf_appMgmt
   }
   @endverbatim
 *
 * @section c_taf_appMgmt_control Application control
 *
 * - taf_appMgmt_Start() -- Starts an app.
 * - taf_appMgmt_Stop() -- Stops an app.
 * - taf_appMgmt_Uninstall() -- Uninstalls an app.
 *
 * @section c_taf_appMgmt_information Application information query
 *
 * - taf_appMgmt_CreateAppList() / taf_appMgmt_DeleteAppList() -- Creates/Releases an app list.
 * - taf_appMgmt_GetFirstApp() / taf_appMgmt_GetNextApp() -- Iterates through the app list.
 * - taf_appMgmt_GetAppDetails() -- Gets static app information.
 * - taf_appMgmt_GetState() / taf_appMgmt_GetVersion() -- Queries app state or version.
 *
 * @code
   taf_appMgmt_AppListRef_t listRef = taf_appMgmt_CreateAppList();
   taf_appMgmt_AppRef_t appRef = taf_appMgmt_GetFirstApp(listRef);
   while (appRef != NULL)
   {
       taf_appMgmt_AppInfo_t appInfo;
       taf_appMgmt_GetAppDetails(appRef, &appInfo);
       LE_INFO("App %s version %s", appInfo.name, appInfo.version);
       appRef = taf_appMgmt_GetNextApp(listRef);
   }
   taf_appMgmt_DeleteAppList(listRef);
   @endcode
 *
 * @code
   taf_appMgmt_Start("sampleApp");
   taf_appMgmt_Stop("sampleApp");
   taf_appMgmt_Uninstall("sampleApp");
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;


//--------------------------------------------------------------------------------------------------
/**
 * App name length without null terminator.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APP_NAME_BYTES = 48;

//--------------------------------------------------------------------------------------------------
/**
 * App version string length without null terminator.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APP_VERSION_BYTES = 101;

//--------------------------------------------------------------------------------------------------
/**
 * App hash string length without null terminator.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APP_HASH_BYTES = 101;

//--------------------------------------------------------------------------------------------------
/**
 * App list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE AppList;

//--------------------------------------------------------------------------------------------------
/**
 * App reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE App;

//--------------------------------------------------------------------------------------------------
/**
 * App running state.
 */
//--------------------------------------------------------------------------------------------------
ENUM AppState
{
    STATE_STOPPED, ///< App is not running.
    STATE_STARTED  ///< App is running.
};

//--------------------------------------------------------------------------------------------------
/**
 * App start mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM AppStartMode
{
    START_MANUAL, ///< Started manually.
    START_AUTO    ///< Started automatically.
};

//--------------------------------------------------------------------------------------------------
/**
 * App information.
 */
//--------------------------------------------------------------------------------------------------
STRUCT AppInfo
{
    string name[APP_NAME_BYTES];       ///< App name.
    string version[APP_VERSION_BYTES]; ///< App version.
    string hash[APP_HASH_BYTES];       ///< App hash.
    AppStartMode startMode;            ///< Start mode.
    bool isSandboxed;                  ///< True if sandboxed.
    bool isActivated;                  ///< True if active.
};

//--------------------------------------------------------------------------------------------------
/**
 * Gets the current running state of an app.
 *
 * @return
 *  - TAF_APPMGMT_STATE_STOPPED -- App is not running.
 *  - TAF_APPMGMT_STATE_STARTED -- App is running.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION AppState GetState
(
    string appName[APP_NAME_BYTES] IN ///< App name.
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the version string of an app.
 *
 * @return
 *  - LE_OK -- Success.
 *  - LE_BAD_PARAMETER -- appName or version is null.
 *  - LE_NOT_FOUND -- App has no stored version.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVersion
(
    string appName[APP_NAME_BYTES] IN,    ///< App name.
    string version[APP_VERSION_BYTES] OUT ///< App version string.
) = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Starts an app.
 *
 * @b NOTE: Newly installed inactive apps enter probation state when started for the first time.
 *
 * @return
 *  - LE_OK -- App started or probation-start queued.
 *  - LE_DUPLICATE -- App is already running.
 *  - LE_BUSY -- System cannot start the app yet.
 *  - LE_FAULT -- Start request failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Start
(
    string appName[APP_NAME_BYTES] IN ///< App name.
) = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Stops an app.
 *
 * @b NOTE: Apps in install, probation, or rollback cannot be stopped.
 *
 * @return
 *  - LE_OK -- App stopped successfully.
 *  - LE_NOT_FOUND -- App not found or not running.
 *  - LE_FAULT -- App is in a managed update workflow.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Stop
(
    string appName[APP_NAME_BYTES] IN ///< App name.
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Uninstalls an app.
 *
 * @b NOTE: Apps in install, probation, or rollback cannot be uninstalled.
 *
 * @return
 *  - LE_OK -- App uninstalled successfully.
 *  - LE_NOT_FOUND -- App does not exist.
 *  - LE_BUSY -- System cannot remove the app yet.
 *  - LE_FAULT -- App is in a managed update workflow or removal failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Uninstall
(
    string appName[APP_NAME_BYTES] IN ///< App name.
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Creates a snapshot list of installed user apps.
 *
 * @return
 *  - Non-null -- App list reference.
 *  - Null -- No apps available or list creation failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION AppList CreateAppList
(
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Releases an app list and all derived references.
 *
 * @return
 *  - LE_OK -- App list released successfully.
 *  - LE_BAD_PARAMETER -- appListRef is null.
 *  - LE_NOT_FOUND -- appListRef is not valid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteAppList
(
    AppList appListRef IN ///< App list reference.
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the first app in the list.
 *
 * @return
 *  - Non-null -- Reference to the first app.
 *  - Null -- List is invalid or empty.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION App GetFirstApp
(
    AppList appListRef IN ///< App list reference.
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the next app in the list.
 *
 * @return
 *  - Non-null -- Reference to the next app.
 *  - Null -- List is invalid or end of list reached.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION App GetNextApp
(
    AppList appListRef IN ///< App list reference.
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Gets static information for an app.
 *
 * @b NOTE: Information is captured at list creation time.
 *
 * @return
 *  - LE_OK -- App information returned successfully.
 *  - LE_BAD_PARAMETER -- appRef or appInfo is null.
 *  - LE_NOT_FOUND -- appRef is not valid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAppDetails
(
    App appRef IN,      ///< App reference.
    AppInfo appInfo OUT ///< App information.
) = 9;